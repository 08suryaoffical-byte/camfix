<script>
  // Simple micro-interactions for Master Command Center
  (function() {
    const modal = document.getElementById('smartDispatchModal');
    const openBtn = document.getElementById('dispatchModalTrigger');
    const closeBtn = document.getElementById('closeDispatchModal');
    const cancelBtn = document.getElementById('cancelDispatchModal');
    const confirmBtn = document.getElementById('confirmRebalance');

    function toggleModal(show) {
      if (show) {
        modal.classList.remove('hidden');
        modal.classList.add('flex');
      } else {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
      }
    }

    if (openBtn) openBtn.addEventListener('click', () => toggleModal(true));
    if (closeBtn) closeBtn.addEventListener('click', () => toggleModal(false));
    if (cancelBtn) cancelBtn.addEventListener('click', () => toggleModal(false));
    
    if (confirmBtn) {
      confirmBtn.addEventListener('click', () => {
        confirmBtn.innerText = 'Applied Successfully ✓';
        confirmBtn.classList.remove('bg-primary-container');
        confirmBtn.classList.add('bg-secondary');
        setTimeout(() => {
          toggleModal(false);
          confirmBtn.innerText = 'Execute Rebalance Protocol';
          confirmBtn.classList.remove('bg-secondary');
          confirmBtn.classList.add('bg-primary-container');
        }, 800);
      });
    }

    // Modal background click to close
    modal.addEventListener('click', (e) => {
      if (e.target === modal) toggleModal(false);
    });
  })();
</script></main></div></body></html>