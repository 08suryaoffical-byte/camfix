<script>
    function switchSubmissionMode(mode) {
      const photoTab = document.getElementById('methodPhotoTab');
      const textTab = document.getElementById('methodTextTab');
      
      if (mode === 'photo') {
        photoTab.className = "px-2.5 py-1 text-label-sm font-label-sm rounded-md bg-surface-container-lowest text-primary shadow-sm transition-all font-semibold flex items-center gap-1";
        textTab.className = "px-2.5 py-1 text-label-sm font-label-sm rounded-md text-on-surface-variant hover:text-on-surface transition-all flex items-center gap-1";
      } else {
        textTab.className = "px-2.5 py-1 text-label-sm font-label-sm rounded-md bg-surface-container-lowest text-primary shadow-sm transition-all font-semibold flex items-center gap-1";
        photoTab.className = "px-2.5 py-1 text-label-sm font-label-sm rounded-md text-on-surface-variant hover:text-on-surface transition-all flex items-center gap-1";
      }
    }

    function togglePhotoTab(view) {
      const btnBefore = document.getElementById('btnBeforePhoto');
      const btnAfter = document.getElementById('btnAfterPhoto');
      const photoBefore = document.getElementById('photoBeforeFrame');
      const photoAfter = document.getElementById('photoAfterFrame');

      if (view === 'before') {
        btnBefore.className = "px-3 py-1 font-label-sm text-label-sm rounded-md bg-surface-container-lowest text-primary shadow-xs font-semibold";
        btnAfter.className = "px-3 py-1 font-label-sm text-label-sm rounded-md text-on-surface-variant hover:text-on-surface";
        photoBefore.classList.remove('opacity-40');
        photoAfter.classList.add('opacity-40');
      } else {
        btnAfter.className = "px-3 py-1 font-label-sm text-label-sm rounded-md bg-surface-container-lowest text-primary shadow-xs font-semibold";
        btnBefore.className = "px-3 py-1 font-label-sm text-label-sm rounded-md text-on-surface-variant hover:text-on-surface";
        photoAfter.classList.remove('opacity-40');
        photoBefore.classList.add('opacity-40');
      }
    }

    function openDetailDrawer(ticketId) {
      const drawer = document.getElementById('incidentDetailDrawer');
      if (drawer) {
        drawer.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
    }

    function triggerReopenModal(ticketRef) {
      document.getElementById('reopenTicketRef').innerText = ticketRef;
      document.getElementById('reopenModal').classList.remove('hidden');
    }

    function closeReopenModal() {
      document.getElementById('reopenModal').classList.add('hidden');
    }

    function confirmReopenAction() {
      alert("Incident re-opened successfully. Escalation pushed to Operations Supervisor & assigned technician Kumar R.");
      closeReopenModal();
    }
  </script>
